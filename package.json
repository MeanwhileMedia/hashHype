    "highlight.js": "^10.7.1",
    "koa": "^2.13.1",
    "koa-static": "^5.0.0",
    "koa-websocket": "^6.0.0",
    "levelup": "^5.1.1",
    "mathjs": "^10.0.2",
    "natural": "^5.1.0",
    "node-html-parser": "^5.1.0",
    "nodemailer": "^6.6.3",
    "normalize-url": "^5.3.0",
    "npm": "^7.6.0",
    "pm2": "^4.5.5",
    "radium": "^0.26.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "redis": "^3.0.2",
